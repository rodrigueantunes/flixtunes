PUID=1000
PGID=1000
PORT=4000
FLIXTUNES_DATA_ROOT=./data
FLIXTUNES_MEDIA_ROOT=./media
TMDB_ACCESS_TOKEN=
TVDB_API_KEY=
TVDB_PIN=
FANART_API_KEY=
# Connecteurs strictement officiels/licenciés : aucun scraping IMDb ou Allociné.
IMDB_LICENSED_API_URL=
IMDB_LICENSED_API_TOKEN=
ALLOCINE_LICENSED_API_URL=
ALLOCINE_LICENSED_API_TOKEN=
FLIXTUNES_HW_ACCEL=auto
# Tone mapping HDR vers SDR. auto = libplacebo/Vulkan si présent, sinon zscale logiciel.
# vaapi et opencl ne sont utilisés que sur demande explicite, tant qu'ils ne sont pas mesurés sur le NAS.
FLIXTUNES_TONEMAP=auto
FLIXTUNES_TRANSCODE_CONCURRENCY=2
# Part de la capacité mesurée offerte aux conversions. Le reste protège interface, analyses et lectures directes.
FLIXTUNES_TRANSCODE_HEADROOM=0.6
FLIXTUNES_MIN_FREE_MEMORY_MB=384
FLIXTUNES_THERMAL_LIMIT_C=85
FLIXTUNES_TRANSCODE_CACHE_HOURS=6
FLIXTUNES_TRANSCODE_CACHE_MAX_MB=8192
FLIXTUNES_WATCH_POLLING=0
FLIXTUNES_SCAN_INTERVAL_HOURS=6
FLIXTUNES_BACKUP_INTERVAL_HOURS=24
FLIXTUNES_BACKUP_RETENTION=7
# Facultatif : protège les écritures API. À laisser vide pour les clients 0.0.x sur un LAN de confiance.
FLIXTUNES_API_TOKEN=

# --- Accès distant sécurisé -----------------------------------------------------------------------
# Vide = aucun accès distant : ni seconde écoute, ni port lié, ni certificat demandé.
# Le domaine est la seule clé qui active la fonction ; tout le reste a un défaut utilisable.
FLIXTUNES_WAN_DOMAIN=
# L'écoute distante parle en clair sur la BOUCLE LOCALE : c'est le proxy, devant, qui porte TLS.
# La passer sur 0.0.0.0 l'exposerait en clair au réseau — et à Internet en cas d'erreur de redirection.
FLIXTUNES_WAN_HOST=127.0.0.1
FLIXTUNES_WAN_PORT=4001
# Ports du proxy côté NAS. La box redirige 80 vers le premier et 443 vers le second : les serveurs
# Let's Encrypt joignent l'IP publique sur 80/443, ce qui laisse ces ports-ci libres de tout privilège.
FLIXTUNES_WAN_HTTP_PORT=8080
FLIXTUNES_WAN_HTTPS_PORT=8444
FLIXTUNES_WAN_SESSION_HOURS=12
# Adresses dont l'en-tête X-Forwarded-For est cru. Jamais « true » : le visiteur choisirait alors
# l'adresse sous laquelle il est compté, et le ralentissement du PIN comme le journal perdraient tout sens.
FLIXTUNES_WAN_PROXIES=127.0.0.1,::1
