<Window x:Class="FlixTunes.Windows.PlayerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF" Title="Lecture" WindowState="Maximized" WindowStyle="None" Background="Black" KeyDown="Window_KeyDown">
  <Grid Background="Black"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <vlc:VideoView x:Name="Video" Grid.Row="0"/>
    <Border Grid.Row="0" x:Name="LoadingPanel" Background="#AA000000"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><ProgressBar IsIndeterminate="True" Width="260"/><TextBlock x:Name="LoadingText" Text="Négociation avec le serveur…" HorizontalAlignment="Center" Margin="0,15"/></StackPanel></Border>
    <Button Content="←" Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20" FontSize="22" Background="#77000000" Click="Back_Click"/>
    <Border Grid.Row="1" Background="#EE101722" Padding="18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="TitleText" FontSize="18" FontWeight="Bold"/><TextBlock x:Name="ModeText" Foreground="#8EB3FF"/></StackPanel><ComboBox x:Name="AudioBox" Grid.Column="1" Width="210" Margin="8"/><ComboBox x:Name="SubtitleBox" Grid.Column="2" Width="210" Margin="8"/><ComboBox x:Name="AudioSortieBox" Grid.Column="3" Width="150" Margin="8" ToolTip="Ce que votre sortie audio sait restituer. Le serveur s'y fie pour décider d'un mixage."><ComboBoxItem Content="Stéréo"/><ComboBoxItem Content="5.1"/><ComboBoxItem Content="7.1"/><ComboBoxItem Content="Amplificateur"/></ComboBox><CheckBox x:Name="HdrToggle" Grid.Column="4" Content="Écran HDR" VerticalAlignment="Center" Margin="12" ToolTip="Transmet le HDR tel quel si cet écran sait l'afficher. Sans rapport avec la sortie audio."/><Button Grid.Column="5" Content="Appliquer" Click="ApplyTracks_Click" VerticalAlignment="Center"/></Grid></Border>
  </Grid>
</Window>
