<Window x:Class="FlixTunes.Windows.ServerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Serveur FlixTunes" Width="560" Height="390" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
  <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="Connecter le serveur local" FontSize="26" FontWeight="Bold"/><TextBlock Grid.Row="1" Text="Adresse IP ou nom du NAS. Aucun serveur public n’est utilisé." Foreground="{StaticResource Muted}" Margin="0,8,0,16"/>
    <TextBox x:Name="AddressBox" Grid.Row="2" FontSize="16"/>
    <StackPanel Grid.Row="3" Margin="0,14,0,0"><DockPanel><TextBlock Text="Serveurs détectés sur le réseau" FontWeight="Bold" VerticalAlignment="Center"/><Button Content="Rechercher" Background="#334158" HorizontalAlignment="Right" Click="Discover_Click"/></DockPanel><ListBox x:Name="ServerList" Height="110" Margin="0,7,0,0" SelectionChanged="Server_Selected"/></StackPanel>
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"><Button Content="Annuler" Background="#334158" IsCancel="True"/><Button Content="Se connecter" IsDefault="True" Click="Connect_Click"/></StackPanel>
  </Grid>
</Window>
