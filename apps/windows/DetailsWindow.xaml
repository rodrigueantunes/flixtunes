<Window x:Class="FlixTunes.Windows.DetailsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Fiche" Width="1020" Height="760" MinWidth="760" MinHeight="550" WindowStartupLocation="CenterOwner">
  <Grid><Grid.RowDefinitions><RowDefinition Height="340"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Background="#102957"><Image x:Name="Backdrop" Stretch="UniformToFill" Opacity=".52"/><Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#F010141D"/><GradientStop Color="#1010141D" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle><StackPanel VerticalAlignment="Bottom" Margin="42"><TextBlock x:Name="Kind" Foreground="#8EB3FF" FontWeight="Bold"/><TextBlock x:Name="TitleText" FontSize="49" FontWeight="Black" TextWrapping="Wrap"/><TextBlock x:Name="Meta" Foreground="#C6CFDF" Margin="0,5"/><StackPanel Orientation="Horizontal"><Button Content="▶  Lecture" Click="Play_Click"/><Button x:Name="WatchedButton" Content="✓ Marquer vu" Background="#334158" Click="Watched_Click"/></StackPanel></StackPanel><Button Content="×" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="15" FontSize="20" Background="#77000000" Click="Close_Click"/></Grid>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="38,25"><TextBlock x:Name="Overview" TextWrapping="Wrap" FontSize="16" Foreground="#C5CDDD" MaxWidth="850" HorizontalAlignment="Left"/>
      <DockPanel Margin="0,25,0,10"><TextBlock Text="Épisodes" FontSize="23" FontWeight="Bold"/><ComboBox x:Name="SeasonBox" Width="150" HorizontalAlignment="Right" SelectionChanged="Season_Changed"/></DockPanel>
      <ItemsControl x:Name="EpisodeItems"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#22FFFFFF" BorderThickness="0,1,0,0" Padding="8,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="▶" Tag="{Binding}" Click="Episode_Click" Height="45"/><StackPanel Grid.Column="1" Margin="14,0"><TextBlock Text="{Binding Title}" FontWeight="Bold"/><TextBlock Text="{Binding Overview}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" MaxHeight="42"/><ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="3" Margin="0,7,0,0"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding Meta}" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel></ScrollViewer>
  </Grid>
</Window>
