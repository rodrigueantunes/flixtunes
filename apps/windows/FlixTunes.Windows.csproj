<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FlixTunes</AssemblyName>
    <RootNamespace>FlixTunes.Windows</RootNamespace>
    <Version>0.5.6</Version>
    <ApplicationIcon>Assets\FlixTunes.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LibVLCSharp.WPF" Version="3.10.0" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" />
    <PackageReference Include="Zeroconf" Version="3.7.16" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\flixtunes-mark.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\flixtunes-startup.wav" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup><Compile Remove="tests\**\*.cs"/><EmbeddedResource Remove="tests\**\*"/><None Remove="tests\**\*"/></ItemGroup>
</Project>
