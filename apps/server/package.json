{
  "name": "@flixtunes/server",
  "version": "0.5.7",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --no-file-parallelism",
    "test:mdns": "tsx integration/mdns.integration.ts",
    "test:watcher": "tsx integration/watcher.integration.ts",
    "test:ffmpeg": "tsx integration/playback.integration.ts",
    "test:codecs": "tsx integration/codec-matrix.integration.ts",
    "test:qualification": "tsx integration/qualification.integration.ts",
    "test:detection": "tsx integration/detection-corpus.integration.ts",
    "test:scale": "tsx integration/catalog-scale.integration.ts",
    "test:live-corpus": "tsx integration/live-corpus.integration.ts",
    "test:scan-cost": "tsx integration/scan-cost.integration.ts",
    "seed:showcase": "tsx integration/seed-showcase.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@flixtunes/contracts": "workspace:*",
    "bonjour-service": "^1.4.4",
    "chokidar": "^5.0.0",
    "fastify": "^5.5.0",
    "mime-types": "^3.0.1",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/mime-types": "^2.1.4",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
