{
  "name": "@flixtunes/desktop",
  "version": "0.5.7",
  "private": true,
  "description": "Client de bureau FlixTunes — l'interface du Web, la lecture par VLC",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copier-pages.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types src/*.test.ts",
    "start": "pnpm build && electron .",
    "vlc": "node ../../packaging/bureau/preparer-vlc.mjs",
    "paquet": "node ../../packaging/bureau/construire.mjs"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "typescript": "^5.9.2",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "tv.flixtunes.bureau",
    "productName": "FlixTunes",
    "copyright": "FlixTunes — GPL v3",
    "directories": {
      "output": "release",
      "buildResources": "ressources-paquet"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/vlc",
        "to": "vlc"
      },
      {
        "from": "../../LICENSE",
        "to": "LICENSE"
      }
    ],
    "win": {
      "target": [
        "msi"
      ],
      "icon": "ressources-paquet/icon.png"
    },
    "msi": {
      "oneClick": false,
      "perMachine": false,
      "runAfterFinish": true
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "icon": "ressources-paquet/icones",
      "category": "AudioVideo",
      "description": "Client de bureau FlixTunes : le client Web, et la lecture par VLC.",
      "synopsis": "FlixTunes sur votre ordinateur",
      "executableName": "flixtunes"
    },
    "deb": {
      "afterInstall": "ressources-paquet/apres-installation.sh",
      "afterRemove": "ressources-paquet/apres-suppression.sh",
      "depends": [
        "libarchive13t64",
        "libaribb24-0t64",
        "libasound2t64",
        "libass9",
        "libavahi-client3",
        "libavahi-common3",
        "libavc1394-0",
        "libavcodec62",
        "libavformat62",
        "libavutil60",
        "libbluray3",
        "libc6",
        "libcairo2",
        "libcddb2",
        "libchromaprint1",
        "libdav1d7",
        "libdbus-1-3",
        "libdc1394-25",
        "libdvbpsi10",
        "libdvdnav4",
        "libdvdread8t64",
        "libebml5",
        "libfaad2",
        "libflac14",
        "libfontconfig1",
        "libfreetype6",
        "libfribidi0",
        "libgcc-s1",
        "libgcrypt20",
        "libglib2.0-0t64",
        "libgnutls30t64",
        "libgpg-error0",
        "libharfbuzz0b",
        "libixml11t64",
        "libjpeg8",
        "libkate1",
        "liblirc-client0t64",
        "liblua5.4-0",
        "libmatroska7",
        "libmpcdec6",
        "libmpg123-0t64",
        "libmtp9t64",
        "libncursesw6",
        "libnfs14",
        "libogg0",
        "libopenmpt-modplug1",
        "libopus0",
        "libpng16-16t64",
        "libprotobuf-lite32t64",
        "libpulse0",
        "libraw1394-11",
        "libresid-builder0c2a",
        "librsvg2-2",
        "libsamplerate0",
        "libsecret-1-0",
        "libshine3",
        "libshout3",
        "libsidplay2",
        "libsoxr0",
        "libspatialaudio0t64",
        "libspeex1",
        "libspeexdsp1",
        "libssh2-1t64",
        "libstdc++6",
        "libswscale9",
        "libsystemd0",
        "libtag2",
        "libtheoradec2",
        "libtheoraenc2",
        "libtinfo6",
        "libtwolame0",
        "libudev1",
        "libupnp17t64",
        "libva-drm2",
        "libva2",
        "libvorbis0a",
        "libvorbisenc2",
        "libx264-165",
        "libx265-215",
        "libxcb-keysyms1",
        "libxcb1",
        "libxml2-16",
        "libzvbi0t64",
        "zlib1g"
      ],
      "compression": "gz"
    },
    "artifactName": "FlixTunes-Bureau-${env.FLIXTUNES_ESTAMPILLE}-${arch}.${ext}",
    "electronVersion": "33.4.11",
    "npmRebuild": false
  },
  "author": {
    "name": "Rodrigue Antunes",
    "email": "rodrigue.antunes@gmail.com"
  },
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/rodrigueantunes/flixtunes"
}
