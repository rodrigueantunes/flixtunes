    "hls.js": "^1.6.16",
    "vite": "^7.1.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite-plugin-pwa": "^1.0.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.11",
    "@types/react-dom": "^19.1.7",
    "axe-core": "4.13.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
