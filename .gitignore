node_modules/
.pnpm-store/
dist/
.vite/
coverage/
# Le repertoire de donnees du service, **a la racine seulement**. Sans la barre oblique initiale, ce
# motif s'applique a n'importe quelle profondeur : il avait silencieusement exclu du depot les treize
# fichiers Kotlin de `apps/android/.../app/data` — client d'API, entrepot, modeles, decouverte de
# serveur, adresses, session. Le depot publie ne pouvait pas construire l'application Android.
/data/
*.db
*.db-shm
*.db-wal
.env
.DS_Store
Thumbs.db
local.properties
.gradle/
**/build/

# Sorties de compilation .NET. Sans elles, le premier index emportait dix copies de
# `libavcodec_plugin.dll` — dix-sept mégaoctets pièce — pour quatre cibles et deux configurations.
publish/

# Base de données et clés propres aux suites de tests. Elles contiennent une clé de chiffrement de
# fournisseurs — de test, mais une clé quand même — et plus de cent mégaoctets de données générées.
.vitest-data/
apps/server/.vitest-data/
TestResults/

# Artefacts de livraison : deux cents mégaoctets par paquet, reconstructibles à l'identique depuis
# les sources. Ils se publient, ils ne se versionnent pas.
artifacts/
*.apk
*.apkg

# Caches Python des utilitaires d empaquetage.
__pycache__/
*.pyc

# Configuration locale de l outillage : votre choix, retiree du depot le 26 aout 2026.
.claude/

# La copie de VLC que l'installateur emporte, et les paquets qu'il produit. Cent vingt mégaoctets de
# binaires reconstruits à la demande par `packaging/bureau/preparer-vlc.mjs` : ils n'ont rien à faire
# dans l'historique.
apps/desktop/vendor/
apps/desktop/release/

# Le relais vers fpm et le « ar » que `construire.mjs` compile pour empaqueter sous Windows. Deux
# exécutables de trente lignes, refaits en une seconde à chaque construction.
apps/desktop/outils-paquet/

# Ce que `tools/tv_playlist_checker.py` dépose à côté de lui quand on le lance depuis le dépôt :
# la mesure d'un jour, pas une source.
tools/script.log
tools/m3u.json
tools/channels_status.json
tools/token.json
tools/github_token.txt
